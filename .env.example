# Copy to .env and fill in locally. Never commit .env.
# All variables are optional.

# Crawler identity. Point it at the public repo URL, not a personal email.
CRAWLER_USER_AGENT="SGHealthcareResearchCrawler/1.0 (non-commercial portfolio research; +https://github.com/<owner>/<repo>)"

# data.gov.sg API key, for higher rate limits (free; register on data.gov.sg).
DATAGOV_API_KEY=

