# Every setting this project reads, with where it is set. Nothing here is required to run locally.
# Copy to .env (git-ignored) for the pipeline. NEVER commit .env or a real key: the repo is public.
# The deploy steps and key rotation are in docs/runbook.md ("Deploying" and "Keys and secrets").
# A test (pipeline/tests/test_env_example.py) fails if the code reads a setting not listed here.

# --------------------------------------------------------------------------------------------- #
# Pipeline (sg-health). Read from this .env, or from the real environment, which wins.           #
# In GitHub Actions: repository secrets (Settings > Secrets and variables > Actions).            #
# --------------------------------------------------------------------------------------------- #

# SECRET. data.gov.sg API key, for higher rate limits (free; register on data.gov.sg). Optional.
# GitHub secret name: exactly DATAGOV_API_KEY.
DATAGOV_API_KEY=

# How the crawler identifies itself to the sites it downloads from. Point it at the public repo,
# never a personal email. Optional; the default is below.
CRAWLER_USER_AGENT="SGHealthcareResearchCrawler/1.0 (non-commercial portfolio research; +https://github.com/gabrielneo/sg-care-capacity)"

# Where data/raw and data/build live. Optional; default: data/ at the repo root.
# SG_HEALTH_DATA_DIR=

# --------------------------------------------------------------------------------------------- #
# API (api/). Read from the real environment only, NOT from this file: export them in the shell  #
# locally, or set them in Render's dashboard / render.yaml in production.                        #
# --------------------------------------------------------------------------------------------- #

# Release tag to serve, e.g. data-2026-11-01. "latest" = the newest data-YYYY-MM-DD release that
# isn't marked pre-release (withdrawn). Set an older tag to roll back. Default: latest.
# DATA_SNAPSHOT=latest

# Serve a local snapshot folder instead of downloading one (still verified). Local use only.
# LOCAL_SNAPSHOT_PATH=data/build/publish

# Where downloaded releases are kept between restarts. Default: <tmp>/sg-health-api
# (the Docker image sets /home/api/snapshots).
# SNAPSHOT_CACHE_DIR=

# GitHub repository holding the releases (owner/name). Default: gabrielneo/sg-care-capacity.
# SNAPSHOT_REPO=gabrielneo/sg-care-capacity

# SECRET. Optional GitHub token, used only to raise GitHub's API rate limit when looking up the
# release (60 requests an hour per IP without one; Render's IPs are shared). Use a fine-grained
# token with public repositories read-only access and no other permissions. Sent to api.github.com
# only. In production: Render dashboard only, never in render.yaml.
# GITHUB_TOKEN=

# Origins allowed to call the API from a browser, comma-separated. Default: none. The site calls
# the API from its server, so production leaves this empty. "*" is refused.
# CORS_ALLOW_ORIGINS=http://localhost:3000

# Port to listen on (Docker image only). Default 8000; Render sets it itself.
# PORT=8000

# --------------------------------------------------------------------------------------------- #
# Web (web/). Set in web/.env.local locally (copy web/.env.example) and in Vercel's project       #
# settings (Production and Preview). Read on the server only; never sent to the browser.         #
# --------------------------------------------------------------------------------------------- #

# Base URL of the API, e.g. https://sg-health-api.onrender.com. Required.
# API_BASE_URL=http://127.0.0.1:8000

# Seconds an API response is reused before the site fetches it again: 60 to 86400.
# Default 3600, also used for any invalid value.
# API_REVALIDATE_SECONDS=3600

# "true" serves /dev/components in a production build. Default false (always on in npm run dev).
# SHOW_DEV_PAGES=false

# --------------------------------------------------------------------------------------------- #
# GitHub Actions only (Settings > Secrets and variables > Actions). Not read from this file.     #
# --------------------------------------------------------------------------------------------- #

# SECRET. Render's deploy hook URL (service > Settings > Deploy Hook). The weekly workflow POSTs
# to it after publishing a data release, so the API restarts on the new snapshot. Without it,
# that step is skipped with a notice. Repository secret named exactly RENDER_DEPLOY_HOOK_URL.
# RENDER_DEPLOY_HOOK_URL=

# The API's public URL, e.g. https://sg-health-api.onrender.com. Used to check that the API is
# serving the new release after a restart. Repository VARIABLE (not a secret): API_PUBLIC_URL.
# API_PUBLIC_URL=
