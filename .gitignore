# Python
__pycache__/
*.egg-info/
*.pyc
.venv/
.pytest_cache/
*.duckdb.wal

# OS / editor
.DS_Store

# Secrets: copy .env.example to .env locally; never commit .env
.env

# Data: raw downloads and build outputs stay local (keep the folders via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/build/*
!data/build/.gitkeep

# Local outputs written next to the code by older versions of the pipeline
/singapore_healthcare.duckdb
/SG_Healthcare_Scrape_Report.xlsx

# Web (Next.js)
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo
web/.env*.local
web/test-results/
web/playwright-report/
