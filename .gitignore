# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.duckdb.wal

# OS / editor
.DS_Store

# Secrets: copy .env.example to .env locally; never commit .env
.env

# Data: raw downloads and build outputs stay local (keep the folders via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/build/*
!data/build/.gitkeep

# Legacy (until the weekly workflow publishes to a GitHub Release instead):
# CI still commits data/singapore_healthcare.duckdb and reports/SG_Healthcare_Scrape_Report.xlsx.
# A local DB or report next to the script is not committed.
/singapore_healthcare.duckdb
/SG_Healthcare_Scrape_Report.xlsx
/pipeline/singapore_healthcare.duckdb
/pipeline/SG_Healthcare_Scrape_Report.xlsx
