# Copy to .env.local (git-ignored) and adjust. In production, set the same names in Vercel's
# project settings (Production and Preview). Read on the server only; never sent to the browser,
# so none of these is secret. The full list of the project's settings is in ../.env.example.

# Base URL of the API (api/README.md). Locally: run the API, then the site. Required.
API_BASE_URL=http://127.0.0.1:8000

# Seconds an API response is reused before the site fetches it again: 60 to 86400.
# Default 3600 (the API's own max-age), also used for any invalid value.
API_REVALIDATE_SECONDS=3600

# Set to true to serve /dev/components in a production build (it is always on in `npm run dev`).
SHOW_DEV_PAGES=false
