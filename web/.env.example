# Copy to .env.local (git-ignored) and adjust. Read on the server only; never sent to the browser.
# Base URL of the API (api/README.md). Locally: run the API, then the site.
API_BASE_URL=http://127.0.0.1:8000
# Set to true to serve /dev/components in a production build (it is always on in `npm run dev`).
SHOW_DEV_PAGES=false
