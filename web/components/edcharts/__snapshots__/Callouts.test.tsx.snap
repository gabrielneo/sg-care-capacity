// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Callouts: one snapshot per template > anomaly 1`] = `"Bed waits at Alexandra Hospital were unusually long in the week of 19–25 Oct 2026: 2.1 hours.● Strength: strong · A plain comparison, not a statistical testiCaveat: One unusual week is not a trend.Data as of 31 Oct 2026 (MOH) · Uses data from 19 Oct 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > source_gap 1`] = `"National University Health System (NUHS)'s live bed-wait estimate for National University Hospital (NUH) differs from Ministry of Health (MOH)'s daily figure by a medianMedian: The middle value: half of patients waited longer, half shorter. 1.2 hours.◑ Strength: moderateiCaveat: The two figures measure different things: an estimate at one moment, and the day's medianMedian: The middle value: half of patients waited longer, half shorter. for admitted patients.Data as of 31 Oct 2026 (MOH) · Uses data from 27 Apr 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > trend 1`] = `"Bed waits at Singapore General Hospital have risen about 0.1 hours a week over the last 26 weeks.◑ Strength: moderateiCaveat: Weeks next to each other are similar; the test allows for that.Data as of 31 Oct 2026 (MOH) · Uses data from 27 Apr 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > usual_gap 1`] = `"Alexandra Hospital: bed waitBed wait / boarding: Time a patient spends in the ED after a doctor decides to admit them, waiting for a ward bed. 2.1 hours, 50% above its usual 1.4 hours (week of 19–25 Oct 2026).● Strength: strong · A plain comparison, not a statistical testiCaveat: This compares one week with its recent usual level; it is not a statistical test.Data as of 31 Oct 2026 (MOH) · Uses data from 19 Oct 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > volume_vs_wait 1`] = `"At National University Hospital, bed waitsBed wait / boarding: Time a patient spends in the ED after a doctor decides to admit them, waiting for a ward bed. move moderately with Emergency Department (ED) visits the day before.◔ Strength: weakiCaveat: This is an association only; it does not show why waits move.Data as of 31 Oct 2026 (MOH) · Uses data from 27 Apr 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > weekday (hospital) 1`] = `"At Sengkang General Hospital, bed waitsBed wait / boarding: Time a patient spends in the ED after a doctor decides to admit them, waiting for a ward bed. are longest on Tuesdays, 43% above its weekly average.◑ Strength: moderateiCaveat: The test shows that weekdays differ; the peak day is the one with the highest average.Data as of 31 Oct 2026 (MOH) · Uses data from 27 Apr 2026 to 25 Oct 2026 · Read the finding"`;

exports[`Callouts: one snapshot per template > weekday (pooled) 1`] = `"Across all hospitals, bed waitsBed wait / boarding: Time a patient spends in the ED after a doctor decides to admit them, waiting for a ward bed. are longest on Mondays, 12% above each hospital's weekly average.◑ Strength: moderateiCaveat: Each hospital's waits are compared with its own weekly average before pooling.Data as of 31 Oct 2026 (MOH) · Uses data from 27 Apr 2026 to 25 Oct 2026 · Read the finding"`;
