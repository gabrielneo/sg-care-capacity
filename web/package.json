{
  "name": "sg-care-capacity-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/lint-terms.mjs && npm run readability",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../api/openapi.json -o lib/api/schema.d.ts",
    "check:api-types": "npm run gen:api && git diff --exit-code -- lib/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "gen:glossary": "node scripts/gen-glossary.mjs",
    "check:glossary": "npm run gen:glossary && git diff --exit-code -- lib/glossary.generated.ts",
    "predev": "npm run gen:glossary",
    "prebuild": "npm run gen:glossary",
    "lint:terms": "node scripts/lint-terms.mjs",
    "readability": "vitest run test/readability.test.ts --silent=false",
    "lighthouse": "bash scripts/lighthouse.sh"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@vercel/analytics": "2.0.1",
    "hast-util-to-string": "3.0.1",
    "leaflet": "1.9.4",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
